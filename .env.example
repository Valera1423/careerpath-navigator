# === Backend ===
# SQLite (работает из коробки):
# DATABASE_URL=sqlite:////app/data/careerpath.db
#
# PostgreSQL (запуск: docker compose --profile postgres up):
# DATABASE_URL=postgresql+psycopg://careerpath:careerpath@db:5432/careerpath

TRUDVSEM_BASE_URL=http://opendata.trudvsem.ru/api/v1
TRUDVSEM_TIMEOUT=15
TRUDVSEM_RETRIES=2

CORS_ORIGINS=*

# === MAX ===
# Токен бота выдают организаторы хакатона.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=change-me

# Публичный HTTPS-адрес мини-приложения (Web App).
# Пример: https://your-tunnel.ngrok-free.app
WEBAPP_URL=

# Публичный HTTPS-адрес вебхука (для регистрации бота в MAX).
# Пример: https://your-tunnel.ngrok-free.app/webhook/max
WEBHOOK_URL=

# true — разрешает dev-заголовок X-Max-User-Id без подписи.
# В production ОБЯЗАТЕЛЬНО false.
ALLOW_INSECURE_INIT_DATA=true

# === Admin ===
ADMIN_SECRET=change-me-in-production

# === Rate limits ===
RATE_LIMIT_ONBOARDING=10/minute
RATE_LIMIT_REGENERATE=5/minute
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_EMPLOYER=1000/hour

# === Cache ===
CACHE_TTL_HOURS=8

# === Frontend ===
VITE_API_BASE=/api/v1
VITE_DEV_USER_ID=dev-user-1